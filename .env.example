# ---- Server ---------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
# development | production — production refuses to start with placeholder
# secrets/passwords below (fail-safe guard, see docs/deployment.md)
APP_ENV=production

# ---- Database --------------------------------------------------------------
APP_DATABASE_PATH=/app/data/search-relay.sqlite3

# ---- Security ---------------------------------------------------------------
# MUST be a long random value, e.g. `openssl rand -hex 32`. The app refuses to
# start in production with any of the placeholder strings shown here.
APP_SECRET_KEY=replace-with-a-long-random-secret
# Initial admin password — change after first login. Same placeholder guard.
ADMIN_PASSWORD=replace-with-a-strong-password
# Set true when the admin UI is served over HTTPS (any TLS-terminating proxy).
COOKIE_SECURE=true

# ---- Upstream ----------------------------------------------------------------
UPSTREAM_TIMEOUT_SECONDS=60
# Total upstream attempts per relay request (caps retries regardless of key-pool size)
MAX_UPSTREAM_ATTEMPTS=3

# ---- Cache -------------------------------------------------------------------
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=43200
SEARCH_CACHE_MAX_ROWS=10000

# ---- Logs ---------------------------------------------------------------------
# Prune request_logs older than N days at startup
REQUEST_LOG_RETENTION_DAYS=30
